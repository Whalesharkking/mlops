# Copy to .env and replace the placeholders. Never commit .env.
# Hugging Face token with write access to the feature-store dataset.
HF_TOKEN=hf_your_token_here
# Dataset repo used as the feature store, <user>/<name>.
HF_DATASET_REPO=your-hf-user/nectarflow-features
# Local working directory for the Parquet files (gitignored).
DATA_DIR=data
